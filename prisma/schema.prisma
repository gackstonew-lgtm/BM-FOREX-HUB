// Prisma Schema for BM Forex Hub User Management & Audit Logging

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ROLE_ADMIN
  ROLE_SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuditAction {
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_DELETED
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  firstName        String?
  lastName         String?
  phone            String?
  role             UserRole    @default(USER)
  status           UserStatus  @default(ACTIVE)
  tokenVersion     Int         @default(0) // Incremented to invalidate all active JWTs
  suspendedAt      DateTime?
  suspensionReason String?
  deletedAt        DateTime?   // Soft-delete timestamp for compliance retention
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Audit Logs relations
  auditLogsTarget  AuditLog[]  @relation("TargetUser")
  auditLogsAdmin   AuditLog[]  @relation("AdminUser")

  // Transactions / Financial Records (Ledger integrity preserved)
  transactions     Transaction[]

  @@map("users")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Decimal  @db.Decimal(18, 4)
  currency  String
  type      String   // DEPOSIT, WITHDRAWAL, TRADE, REMITTANCE
  status    String   // PENDING, COMPLETED, FAILED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model AuditLog {
  id           String      @id @default(uuid())
  adminId      String
  targetUserId String
  action       AuditAction
  reason       String      @db.Text
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  admin      User @relation("AdminUser", fields: [adminId], references: [id])
  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([action])
  @@map("audit_logs")
}
